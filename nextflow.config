/*
 * migrate-to-db-nf: Nextflow pipeline for database migration
 *
 * Import GWAS mapping TSV files to Parquet database structure
 */

// Pipeline version
manifest {
    name            = 'migrate-to-db-nf'
    author          = 'Ryan McKeown'
    description     = 'Pipeline to migrate GWAS mapping files to Parquet database'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// Default parameters
params {
    // Input/Output
    input           = null          // Input directory containing mapping TSV files
    eigen_dir       = null          // Directory containing EIGEN files (optional, auto-detected)
    output          = './results/db' // Output database directory

    // Processing options
    overwrite       = false         // Replace existing mappings
    batch_name      = null          // Name for this batch (for reports)

    // QTL Analysis (optional, runs after migration with --analyze_qtl)
    analyze_qtl     = false         // Enable QTL analysis after migration
    alpha           = 0.05          // Significance level for thresholds
    ci_size         = 150           // Markers left/right of peak for CI
    snp_grouping    = 1000          // Max marker distance to group into same QTL
    qtl_output      = null          // QTL output directory (default: {output}/qtl)

    // For standalone QTL re-runs (workflows/analyze_qtl.nf)
    mapping_db      = null          // Path to existing mapping database
    population      = null          // Filter to specific population
    algorithm       = null          // Filter to INBRED or LOCO

    // Resource defaults
    max_cpus        = 16
    max_memory      = '64.GB'
    max_time        = '4.h'
}

// Enable module binaries - adds resources/usr/bin/ from each module to task PATH
nextflow.enable.moduleBinaries = true

// Load base config with resource defaults
includeConfig 'conf/base.config'

// Profile definitions
profiles {
    standard {
        process.executor = 'local'
    }

    rockfish {
        includeConfig 'conf/rockfish.config'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    test {
        params.input = 'data/test/test_mappings'
        params.output = 'results/test_db'
    }
}

// Execution reports
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.output}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.output}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.output}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

// Function to check max resources
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max memory '${params.max_memory}' is not valid! Using default value"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ### Max time '${params.max_time}' is not valid! Using default value"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ### Max cpus '${params.max_cpus}' is not valid! Using default value"
            return obj
        }
    }
}
