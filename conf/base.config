/*
 * Base configuration with default resource allocations
 * Style matches nemascan-sims-nf/conf/example_rf.config
 */

process {
    // Default resources for all processes
    cpus = 1
    memory = "4G"
    time = "1.hour"

    // Error handling
    //errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    //maxRetries = 3
    //maxErrors = '-1'

    // Local processes - run on head node without container
    withName: 'DISCOVER_MAPPING_FILES|BUILD_EIGEN_LOOKUP|IDENTIFY_MARKER_SETS|DISCOVER_QTL_BATCHES' {
        executor = 'local'
        cpus = 1
        memory = "2G"
        time = "5.minute"
        container = null
    }

    // R processes with specific resource requirements
    withName: 'WRITE_MARKER_SET' {
        cpus = 2
        memory = "8G"
        time = "30.minute"
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'PROCESS_MAPPING' {
        cpus = 1
        memory = "4G"
        time = "10.minute"
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'AGGREGATE_METADATA' {
        cpus = 1
        memory = "4G"
        time = "10.minute"
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'ANALYZE_QTL_BATCH' {
        cpus = 2
        memory = "12G"
        time = "1.hour"
        errorStrategy = 'retry'
        maxRetries = 5
    }
    withName: 'AGGREGATE_QTL_RESULTS' {
        cpus = 1
        memory = "8G"
        time = "20.minute"
        errorStrategy = 'retry'
        maxRetries = 3
    }
}
